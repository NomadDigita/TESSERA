{
  "version": 2,
  "functions": {
    "api/index.py": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/assets/:path*", "destination": "/api/index.py" },
    { "source": "/", "destination": "/api/index.py" }
  ],
  "crons": [
    { "path": "/api/cron/worker", "schedule": "0 0 * * *" }
  ]
}
