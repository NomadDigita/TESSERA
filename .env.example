# Runtime
TESSERA_ENV=development
TESSERA_HOST=127.0.0.1
TESSERA_PORT=8787
TESSERA_DATABASE_PATH=data/tessera.db
TESSERA_BROKER_MODE=mock-paper
TESSERA_LIVE_TRADING_ENABLED=false
TESSERA_REQUIRE_HUMAN_APPROVAL=true
TESSERA_MAX_ORDER_NOTIONAL=1500
TESSERA_MAX_GROSS_EXPOSURE=5000
TESSERA_MAX_SINGLE_ASSET_EXPOSURE=2500

# Authentication (required in production)
TESSERA_AUTH_ENABLED=false
TESSERA_SESSION_SECRET=
TESSERA_SESSION_TTL_SECONDS=28800
TESSERA_LOGIN_RATE_LIMIT=5
TESSERA_API_RATE_LIMIT=120
TESSERA_ADMIN_USERNAME=admin
TESSERA_ADMIN_PASSWORD=
CRON_SECRET=

# Qwen / DashScope (leave blank until integration phase)
TESSERA_LLM_PROVIDER=deterministic
TESSERA_LLM_FALLBACK_PROVIDER=deterministic
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# Bitget demo / Agentic account (never commit real values)
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_BASE_URL=https://api.bitget.com

# Production services
DATABASE_URL=postgresql://tessera:change-me@postgres:5432/tessera
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=tessera-artifacts
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
JWT_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
